DB_HOST=127.0.0.1
DB_DATABASE=gridwise
DB_USER=gridwise_user
DB_PASSWORD=gridwise_pass
DB_PORT=3306
SERVER_PORT=8000

# DATA_MODE controls the server's behaviour.
#   demo     — simulator posts synthetic telemetry; /demo/* routes are active;
#              every API response includes is_simulated=true and source="synthetic".
#   hardware — real ESP32/PZEM device posts; /demo/* routes return 404;
#              API responses include is_simulated=false and source="esp32-pzem".
DATA_MODE=demo

# A reading older than this is shown as stale in the portal.
STALE_AFTER_SECONDS=10

# Seed for the simulator's random number generator.
# Keep this fixed so the demo run is reproducible.
DEMO_SEED=20261120
